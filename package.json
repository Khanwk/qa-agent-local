{
  "name": "qa-agent-local",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "server": "tsx src/server/index.ts",
    "build": "node scripts-clean.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "test": "npm run build && npm run selftest",
    "install:browser": "playwright install chromium",
    "selftest": "node scripts/selftest.mjs",
    "demo:check": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "axe-core": "^4.10.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "node-fetch": "^3.3.2",
    "playwright": "^1.55.0",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "vite": "^6.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
